# RunPod API key (runpod.io → Settings → API Keys)
RUNPOD_API_KEY=
# Docker image for pods (or pass --image to rp.py launch)
RUNPOD_IMAGE=
# Prefix for this sprint's pod names; cost-guard only acts on these. Default: repo directory name.
# Must be unique on the account and not a hyphen-prefix of another sprint's (el-paso would also match el-paso-v2-*).
RUNPOD_POD_PREFIX=
# Hugging Face token (models, datasets, checkpoints)
HUGGINGFACE_TOKEN=
# Weights & Biases API key
WANDB_API_KEY=
# Optional: ssh public key put on pods. Default: ~/.ssh/runpod_id.pub
# RUNPOD_PUBKEY=
